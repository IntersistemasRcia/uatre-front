	"Comments": {
		"Forma en que se arma un url": {
			"Prioridades (mayor a menor)": [
				"Variables específicas.",
				"Variables por defecto."
			],
			"Toma como valores por defecto las variables": {
				"REACT_APP_PROTOCOL": "Puede ser http o https. (opcional, si se omite, es http)",
				"REACT_APP_SERVER": "Servidor (sin protocolo ni puerto, ni ubicación).",
				"REACT_APP_PORT": "Puerto a utilizar. (opcional).",
				"REACT_APP_PORT_SECURE": "Puerto en caso de utilizar protocolo https. (opcional, si no se especifica, utiliza el mismo valor que REACT_APP_PORT).",
				"REACT_APP_PATH": "Ubicación de las apis en el servidor. (opcional)."
			},
			"Ejemplos": [
				{
					"Variables": {
						"REACT_APP_SERVER": "ejemplific.ar",
	
						"REACT_APP_API_PATH": "api",
	
						"REACT_APP_API1_PORT": 81
					},
					"Resultado": {
						"Si se lee solo la configuración por defecto": "http://ejemplific.ar",
	
						"API": "http://ejemplific.ar/api",
						"API1": "http://ejemplific.ar:81"
					}
				},
				{
					"Variables": {
						"REACT_APP_PROTOCOL": "https",
						"REACT_APP_SERVER": "ejemplific.ar",
						"Comentarios": [
							"Si se especificara REACT_APP_PATH, las variables específicas que no tengan _PATH tomarían su valor.",
							"Ver siguiente ejemplo."
						],
	
						"REACT_APP_API_PATH": "api",
	
						"REACT_APP_API1_PORT_SECURE": 4431
					},
					"Resultado": {
						"Si se lee solo la configuración por defecto": "https://ejemplific.ar",
	
						"API": "https://ejemplific.ar/api",
						"API1": "https://ejemplific.ar:4431",
						"Comentarios API1": [
							"Como no especifica REACT_APP_API1_PATH y no existe REACT_APP_PATH, la version final no tiene ubicación.",
							"Ver siguiente ejemplo."
						]
					}
				},
				{
					"Variables": {
						"REACT_APP_PROTOCOL": "https",
						"REACT_APP_SERVER": "ejemplific.ar",
						"REACT_APP_PATH": "api",
	
						"REACT_APP_API_PORT_SECURE": 4431,
	
						"REACT_APP_API1_PATH": "api1"
					},
					"Resultado": {
						"Si se lee solo la configuración por defecto": "https://ejemplific.ar/api",
	
						"API": "https://ejemplific.ar:4431/api",
						"API1": "https://ejemplific.ar/api1"
					}
				},
				{
					"Variables": {
						"REACT_APP_PROTOCOL": "https",
						"REACT_APP_SERVER": "ejemplific.ar",
						"REACT_APP_PORT": "Tomaría este valor si REACT_APP_PROTOCOL no fuera https o REACT_APP_PORT_SECURE no existiera o fuera vacío.",
						"REACT_APP_PORT_SECURE": 4430,
	
						"REACT_APP_API_PROTOCOL": "http",
						"REACT_APP_API_SERVER": "localhost",
						"REACT_APP_API_PORT": 5266,
						"REACT_APP_API_PORT_SECURE": "Este valor se ignora porque REACT_APP_API_PROTOCOL es http en vez de https.",
						"REACT_APP_API_PATH": "api",
	
						"REACT_APP_API1_SERVER": "localhost",
						"REACT_APP_API1_PORT": 5267,
						"REACT_APP_API1_PATH": "api1",
	
						"REACT_APP_API2_PATH": "api2",
	
						"REACT_APP_API3_PORT_SECURE": 4431
					},
